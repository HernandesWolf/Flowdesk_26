# Copy to .env and adjust. Never commit the real .env file.
POSTGRES_DB=flowdesk
POSTGRES_USER=flowdesk
POSTGRES_PASSWORD=change-me

# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60

# Set to "demo" to load sample data (company, users, customers, orders)
SPRING_PROFILES_ACTIVE=
